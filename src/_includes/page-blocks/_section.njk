{#- Shared by the blocks: a heading, a text and a link with an arrow, from "s" (set it before the include). -#}
{% if s.heading %}<h2>{{ s.heading | markdownInline | safe }}</h2>
{% endif %}{% if s.text %}{{ s.text | markdown | safe }}{% endif %}{% if s.link and s.link.url %}<p><a class="link-arrow" href="{{ s.link.url }}">{{ s.link.label }}</a></p>
{% endif %}
