{#- A heading, text and a participant quote beside it on a computer (under the heading on a phone).
    Join: "Who can join? You can." with Bart; Exchanges: "Before 2025" with Ana.
    "classes" (hidden in the editor) keeps each page's own spacing; "anchor" is the #name that links jump to.
    "fullWidth: true" (Join, Tine file 87) puts heading, text and quote one under the other, over the full width;
    "asCard: true" (Exchanges) puts them in one wide colour card. -#}
{%- if b.asCard and b.quote and b.quote.text %}
{#- "asCard: true" (Exchanges, Before 2025; Tine, 6 November 2026): heading, text and quote together in one wide colour card in
    the quote's colour, the text on the left and the quote on the right, so a short text leaves no empty space. On a phone
    the quote follows the text. -#}
{%- set accent = b.quote.accent or "green" %}
<section class="page-block card-soft colour-card tq-card"{% if b.anchor %} id="{{ b.anchor }}"{% endif %} style="--accent: var(--{{ accent }}){% if accent == 'pink' %}; --tint: 7%{% elif accent == 'lime' %}; --line: color-mix(in srgb, var(--lime) 80%, var(--ink)){% endif %}">
  <div class="tq-card-text">
    <h2>{{ b.heading | sentences | safe }}</h2>
    {{ b.text | markdown | safe }}{% if b.link and b.link.url %}<p><a class="link-arrow" href="{{ b.link.url }}">{{ b.link.label }}</a></p>{% endif %}
  </div>
  {% set q = b.quote %}{% set qClass = "tq-card-quote" %}{% include "blocks/quote-card.njk" %}
</section>
{%- else -%}
<section class="{{ b.classes or 'page-block split has-aside' }}"{% if b.anchor %} id="{{ b.anchor }}"{% endif %}>
  <h2>{{ b.heading | sentences | safe }}</h2>
  <div class="{{ 'join-who-text' if b.fullWidth else 'article' }}">
    {{ b.text | markdown | safe }}{% if b.link and b.link.url %}<p><a class="link-arrow" href="{{ b.link.url }}">{{ b.link.label }}</a></p>
{% endif %}  </div>
  {% if b.quote and b.quote.text %}{% set q = b.quote %}{% set qClass = "" if b.fullWidth else "quote-aside" %}{% include "blocks/quote-card.njk" %}{% endif %}
</section>
{%- endif %}
