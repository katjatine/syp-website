</section>

<section class="section" style="overflow:hidden">
  <div class="container section-head" style="margin-bottom:4px">
    <h3>The river so far</h3>
    <div class="river-legend"><span>So far</span><span class="is-upcoming">Coming up</span></div>
  </div>
  {% river timeline, "home" %}
  <div class="container"><p class="sg-note" style="margin-top:24px">The homepage river: horizontal from 1024 px, vertical below. The first stop, "2008 to 2024", links to the Timeline page.</p></div>
</section>

